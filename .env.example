# "Connect Gemini account": each user signs in with their own Gemini account (OAuth).
# Register an OAuth app (confidential client) at https://exchange.sandbox.gemini.com/settings/api
# with the redirect URI below and scopes account:read, balances:read, orders:read, orders:create.
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
GEMINI_OAUTH_ENV=sandbox             # sandbox | production (production needs Gemini's app approval)
# GEMINI_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/gemini/callback   # default: APP_URL or this site + that path
SESSION_SECRET=                      # long random string; encrypts stored Gemini tokens (openssl rand -base64 48)

# Optional, local development only: a server-side API key (Trader role), used when OAuth isn't
# configured. Never set this on a public deploy: everyone would trade on this one account.
GEMINI_API_KEY=
GEMINI_API_SECRET=
GEMINI_TRADING_ENV=sandbox          # where orders go: sandbox | production
GEMINI_MARKET_DATA_ENV=production   # where public market data comes from (no key needed)
GEMINI_NONCE_MODE=time              # must match the key's nonce setting: time | incremental

# Hedge execution: "paper" fills at live production prices, recorded locally (default);
# "live" places real limit orders where GEMINI_TRADING_ENV points.
HEDGE_EXECUTION=paper
MAX_HEDGE_USD=5000

# AI provider: any OpenAI-compatible API. Defaults to OpenRouter (https://openrouter.ai/keys).
AI_API_KEY=                          # OpenRouter key (sk-or-...)
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=                            # e.g. x-ai/grok-4.20 or anthropic/claude-haiku-5.5; `npm run ai:check` suggests options
# AI_MODE=off                        # testing the UI only: never call the AI (no cost); uses the basic matcher
# AI_LIMIT_PER_HOUR=20               # business analyses per visitor per hour
# AI_DAILY_LIMIT=300                 # AI analyses per day for everyone (~$1); past it the basic matcher takes over
# APP_URL=https://your-app.up.railway.app   # sent to OpenRouter as the app's referer (optional)

# Odds collector
ODDS_INTERVAL_MIN=5

# Odds archive: seal each finished hour of readings with a fingerprint on Solana (Memo program).
# Only fingerprints go on-chain; the odds themselves stay private (Gemini's market data terms).
ARCHIVE_ANCHOR=1                     # 1 = seal hours after each snapshot; also `npm run archive:anchor`
SOLANA_CLUSTER=devnet                # devnet | mainnet-beta
# SOLANA_RPC_URL=                    # optional; defaults to Solana's public RPC for the cluster
# SOLANA_ARCHIVE_SECRET=[...]        # 64-byte secret key as a JSON array; required on mainnet.
#                                    # On devnet a key is created in data/ (fund it at https://faucet.solana.com)
